# Frontend environment. Only NEXT_PUBLIC_* values are bundled into the browser.
# Never put API keys, database URLs or service-role keys here.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Show the development-only "mock upgrade" button on Settings (keep false in production).
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true

NEXT_PUBLIC_APP_NAME=Linkdine AI
