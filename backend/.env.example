# ---------------------------------------------------------------
# Linkdine AI backend configuration (copy to .env and edit)
# NEVER commit a real .env file. Never expose these values to the frontend.
# ---------------------------------------------------------------

APP_NAME=Linkdine AI
ENVIRONMENT=development            # development | test | production
DEBUG=false
LOG_LEVEL=INFO

# Database. Local dev can use SQLite; production should use PostgreSQL + pgvector.
DATABASE_URL=sqlite:///./linkdine.db
# DATABASE_URL=postgresql+psycopg://linkdine:linkdine@localhost:5432/linkdine
AUTO_CREATE_TABLES=true            # set false when you rely on Alembic migrations
VECTOR_STORE=auto                  # auto | pgvector | python

CORS_ORIGINS=http://localhost:3000

# Auth
AUTH_PROVIDER=local                # local | supabase
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ADMIN_EMAILS=                      # comma-separated list of admin emails

# AI generation provider
AI_PROVIDER=mock                   # mock | openai | anthropic
AI_API_KEY=
AI_MODEL=mock-linkdine-v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=900
AI_TEMPERATURE=0.7
AI_INPUT_PRICE_PER_1M=0            # used only to estimate cost in usage logs
AI_OUTPUT_PRICE_PER_1M=0

# Optional fallback provider (only used when the primary fails). Leave empty to disable.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Embeddings (separate from generation model)
EMBEDDING_PROVIDER=hashing         # hashing (local, no API) | openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384                  # must match the pgvector column; 1536 for text-embedding-3-small
EMBEDDING_BASE_URL=

# Plans and limits
FREE_GENERATIONS_PER_DAY=3
FREE_ENHANCEMENTS_PER_DAY=3
PREMIUM_DAILY_CAP=200
FREE_FULL_POST_ENABLED=false       # false = free users get the blueprint, not the full post
PREMIUM_MAX_VARIATIONS=3
ALLOW_MOCK_PAYMENTS=true           # dev only; ignored in production
PAYMENT_PROVIDER=mock

# RAG
RAG_TOP_K=5
RAG_CANDIDATE_MULTIPLIER=4
RAG_WEIGHT_VECTOR=0.6
RAG_WEIGHT_KEYWORD=0.3
RAG_WEIGHT_METADATA=0.1

# Output shaping
LENGTH_SHORT_WORDS=60
LENGTH_MEDIUM_WORDS=120
LENGTH_LONG_WORDS=200
HASHTAG_MAX=5
MAX_INPUT_CHARS=4000
RATE_LIMIT_PER_MINUTE=30

# Ingestion
INGESTION_PII_ACTION=redact        # redact | reject
INGESTION_MAX_ROWS=5000
INGESTION_USE_LLM=false
POST_VALIDATION_USE_LLM=false

# Demo user (used only by scripts/seed_database.py in development)
DEMO_USER_EMAIL=demo@linkdine.dev
DEMO_USER_PASSWORD=DemoPassword123!
