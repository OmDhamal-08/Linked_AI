  "cta_types": [
    "question",
    "invite_comments",
    "share",
    "follow",
    "none"
  ],
  "cta_patterns": {
    "question": "\\?\\s*$",
    "invite_comments": "(comment|comments|let me know|tell me|share your|drop your|your thoughts)",
    "share": "(repost|share this|pass it on|share with)",
    "follow": "(follow me|follow for|follow along|connect with me)"
  },
  "cta_instructions": {
    "question": "End with one open, specific question for readers.",
    "invite_comments": "End by inviting readers to share their own experience in the comments.",
    "share": "End by suggesting readers share the post with someone who could benefit.",
    "follow": "End with a light, non-pushy invitation to follow for more on the topic.",
    "none": "Do not include a call to action."
  },
  "hook_patterns": {
    "achievement": "^(proud|excited|happy|thrilled|finally|just (finished|completed|launched|shipped|passed))",
    "question": "^(have you|did you|do you|what if|ever wondered|why do|how do|is it)|\\?$",
    "story": "^(last|a few|when i|back in|it started|one day|this (week|month|year))",
    "lesson": "^(lesson|here('|’)?s what|here is what|what i learned|mistake|i was wrong|the hard way)",
    "milestone": "(milestone|\\d+\\s*(days|weeks|months|years)|first (day|week|month|year|version|release))",
    "curiosity": "^(most people|nobody|here's why|you won't believe|unpopular opinion|the surprising)",
    "transformation": "^(from .+ to |i used to|now i|before .+ after)"
  },
  "hook_templates": {
    "achievement": [
      "Proud to share a milestone: {event_lower}.",
      "Just wrapped up something I'm proud of: {event_lower}."
    ],
    "question": [
      "What would you do differently if you were starting {topic} today?",
      "Have you ever worked on {topic} from scratch?"
    ],
    "story": [
      "It started with a simple goal around {topic}.",
      "This one began as a small experiment with {topic}."
    ],
    "lesson": [
      "One lesson I want to keep from my work on {topic}.",
      "What I learned from {topic}, in plain terms."
    ],
    "milestone": [
      "Milestone unlocked: {event_lower}.",
      "A checkpoint worth sharing: {event_lower}."
    ],
    "curiosity": [
      "Most people only see the result of {topic}. Here is the process behind it.",
      "The part of {topic} nobody talks about: the process."
    ],
    "transformation": [
      "From idea to finished work: {event_lower}.",
      "How {topic} went from an idea to something real."
    ]
  },
