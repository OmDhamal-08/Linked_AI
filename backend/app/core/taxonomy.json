  "suggestion_messages": {
    "weak_hook": "Open with a specific detail or question in the first line so readers stop scrolling.",
    "generic_opener": "Replace the generic opener (for example 'Excited to share') with the concrete outcome.",
    "missing_cta": "Close with one clear call to action, such as a specific question.",
    "missing_keywords": "Weave in terms your audience searches for, such as: {keywords}.",
    "too_long": "Trim filler sentences; aim for a tighter structure.",
    "too_short": "Add one concrete detail about what you did and what it taught you.",
    "low_readability": "Shorten long sentences and prefer plain words.",
    "excess_hashtags": "Keep 3 to 5 relevant hashtags instead of a long list.",
    "no_structure": "Add a clear progression: hook, context, achievement, lesson, call to action.",
    "no_specifics": "Include one specific number, tool, or step to make the post credible."
  }
